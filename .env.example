# Falcon Environment Variables
# Copy to .env and adjust as needed

# Database
DATABASE_URL=postgresql://falcon:falcon_secret@localhost:5432/falcon

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://falcon:falcon_secret@localhost:5672

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=falcon
S3_SECRET_KEY=falcon_secret
S3_RAW_BUCKET=raw-videos
S3_PROCESSED_BUCKET=processed-videos
S3_REGION=us-east-1

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Service URLs (internal — used by services)
UPLOAD_SERVICE_URL=http://localhost:3011
METADATA_SERVICE_URL=http://localhost:3002
HLS_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite build-time variable)
VITE_API_URL=
