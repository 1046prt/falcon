# Falcon Environment Variables
# Copy to .env and adjust as needed
#
# ⚠️  WARNING: The defaults in this file are for LOCAL DEVELOPMENT ONLY.
#    For production, generate strong unique passwords and never commit secrets.

# Database
DATABASE_URL=postgresql://falcon:falcon_dev@localhost:5432/falcon

# Redis (no auth by default, lock down in production)
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://falcon:falcon_dev@localhost:5672

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=falcon
S3_SECRET_KEY=falcon_dev
S3_RAW_BUCKET=raw-videos
S3_PROCESSED_BUCKET=processed-videos
S3_REGION=us-east-1

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# CDN (set CDN_URL to your CloudFront/Cloudflare distribution for production)
# CDN_URL=https://d123.cloudfront.net
# CDN_SIGNED_URL_ENABLED=false
# CDN_SIGNED_URL_TTL_MS=3600000

# RabbitMQ retry / DLQ
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=30000

# Job timeout (ms)
JOB_TIMEOUT_MS=300000

# Internal service-to-service auth key (change in production)
INTERNAL_API_KEY=falcon-internal-key

# Service URLs (internal — used by services)
UPLOAD_SERVICE_URL=http://localhost:3011
METADATA_SERVICE_URL=http://localhost:3002
HLS_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004

# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite build-time variable)
VITE_API_URL=
