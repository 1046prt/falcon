{
  "name": "falcon",
  "version": "0.1.0",
  "description": "High-Throughput Distributed Video Transcoding Pipeline",
  "private": true,
  "workspaces": [
    "frontend",
    "services/shared",
    "services/api-gateway",
    "services/upload-service",
    "services/metadata-service",
    "services/transcoding-worker",
    "services/hls-service",
    "services/notification-service"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n gateway,upload,metadata,hls,notify -c blue,green,yellow,magenta,cyan \"npm run dev -w @falcon/api-gateway\" \"npm run dev -w @falcon/upload-service\" \"npm run dev -w @falcon/metadata-service\" \"npm run dev -w @falcon/hls-service\" \"npm run dev -w @falcon/notification-service\"",
    "dev:worker": "npm run dev -w @falcon/transcoding-worker",
    "dev:frontend": "npm run dev -w @falcon/frontend",
    "dev:all": "concurrently -n backend,frontend -c blue,magenta \"npm run dev\" \"npm run dev:frontend\"",
    "start": "node scripts/start.js",
    "build": "npm run build -w @falcon/shared && npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "npm run build",
    "db:migrate": "node scripts/migrate.js",
    "verify": "node scripts/verify-health.js",
    "test:e2e": "node scripts/integration-test.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:full": "docker compose -f docker-compose.yml -f docker/docker-compose.services.yml up -d --build",
    "docker:monitoring": "docker compose -f docker-compose.yml -f docker/docker-compose.monitoring.yml up -d",
    "setup": "node scripts/setup.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.18.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "pg": "^8.13.1",
    "typescript-eslint": "^8.18.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.3",
    "jest-environment-node": "^29.7.0",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
